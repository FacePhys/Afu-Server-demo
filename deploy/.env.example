# 复制为 .env 后修改；.env 里有密码，权限设为 600
AFU_VERSION=替换成镜像版本

MYSQL_ROOT_PASSWORD=替换成强密码
MYSQL_PASSWORD=替换成强密码
# 密码要和上面的 MYSQL_PASSWORD 一致；换云数据库时只改这一行
AFU_DB_DSN=afu:替换成MYSQL_PASSWORD@tcp(mysql:3306)/afu?parseTime=true&loc=UTC&charset=utf8mb4

# SDK上报端口绑定的宿主机地址：nginx和服务在同一台机器用127.0.0.1；用云负载均衡转发时改成0.0.0.0
AFU_HTTP_BIND=127.0.0.1
# 宿主机端口，冲突时再改
AFU_HTTP_PORT=8080
AFU_ADMIN_PORT=18081

# 违规次数的缓存(可选)：用宿主机上已有的 Redis，见部署说明「Redis」；留空不用 Redis，直接查库
AFU_REDIS_ADDR=
# 宿主机 /etc/redis/redis.conf 里 requirepass 的值
AFU_REDIS_PASSWORD=
